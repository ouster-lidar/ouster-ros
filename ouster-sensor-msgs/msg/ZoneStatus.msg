# Zone monitoring status generated by the sensor for one frame, parsed out of
# a single zone monitoring (ZM) UDP packet.

# Message header, the stamp is derived from the packet in the same way as the
# other driver messages (sensor timestamp, or host receive time when the
# TIME_FROM_ROS_TIME timestamp mode is selected).
std_msgs/Header header
# Zone measurement timestamp in nanoseconds, as reported by the sensor and
# unaffected by the driver timestamp_mode.
uint64 timestamp
# 256-bit hash of the zone set configuration that produced this status.
uint8[32] zoneset_hash
# State of every zone monitoring slot, always 16 entries; use ZoneState/live to
# tell apart configured zones from empty slots.
ZoneState[] zones
